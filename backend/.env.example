# Django Backend Environment Variables
SECRET_KEY=your_secret_key_here
DEBUG=True

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Email SMTP Settings (SendGrid/Mailgun/Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=no-reply@healthai.com

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Google Calendar OAuth 2.0 (See README.md for setup instructions)
# 1. Go to Google Cloud Console (https://console.cloud.google.com/)
# 2. Create a Project and enable "Google Calendar API"
# 3. Configure OAuth Consent Screen
# 4. Create OAuth 2.0 Client ID Credentials (Web Application)
# 5. Add Authorized redirect URI: http://localhost:8000/api/calendar/google/callback/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/google/callback/
# Frontend URL
FRONTEND_URL=http://localhost:5173
